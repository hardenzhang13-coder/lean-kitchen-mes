# 精益厨房 V3 环境变量示例
# 复制本文件为 .env 并填入真实值

# MySQL 数据库连接字符串（必须）
DATABASE_URL="mysql://user:password@host:port/database"

# Docker Compose MySQL root 密码（生产环境必须另外设置）
DB_PASSWORD="replace-with-a-strong-root-password"

# Docker Compose 最小权限数据库账号（必须为至少 16 位字母或数字）
DB_APP_PASSWORD="GenerateAppPasswordA1"
DB_MIGRATE_PASSWORD="GenerateMigratePasswordB2"
DB_BACKUP_PASSWORD="GenerateBackupPasswordC3"

# migrate diff / migrate dev 影子库（仅本地开发需要，生产不需要）
SHADOW_DATABASE_URL="mysql://user:password@host:port/database_shadow"

# JWT 签名密钥（必须）
# 生产环境请生成随机字符串，长度不少于 32 个字符，且不要提交到版本控制
SESSION_SECRET="your-random-secret-key-min-32-chars"

# 空库首次部署的管理员（已有账号的环境不会覆盖现有账号与密码）
INITIAL_ADMIN_USERNAME="admin"
INITIAL_ADMIN_PASSWORD="replace-with-at-least-10-characters"
INITIAL_ADMIN_NAME="管理员"

# HTTPS 部署后设为 true，Session Cookie 才会带 Secure 标记
FORCE_HTTPS="false"

# 域名 HTTPS 模式（docker-compose.domain.yml 使用）
APP_DOMAIN="kms.example.com"
ACME_EMAIL="admin@example.com"

# 数据库备份加密密钥：使用 openssl rand -base64 48 生成，并与服务器分处保存
BACKUP_ENCRYPTION_KEY="replace-with-a-separately-stored-random-key"

# 预构建部署镜像（GitHub Actions 或 deploy.sh 会自动注入；本地手动部署时也可显式指定）
# WEB_IMAGE="registry.cn-hangzhou.aliyuncs.com/lean-kitchen/lean-kms-web:<提交SHA>"
# MIGRATE_IMAGE="registry.cn-hangzhou.aliyuncs.com/lean-kitchen/lean-kms-migrate:<提交SHA>"

# 以下采购/AI 配置在试运行期间可留空；采购模块重新开放前再配置
QWEN_API_KEY="your-qwen-api-key"
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-vl-max"

# Cloudinary 图片存储（采购/AI 开放时再配置）
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_UPLOAD_PRESET="your-upload-preset"
