generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model DishCategory {
  id          Int     @id @default(autoincrement())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")
  // 展示顺序：设置页可调整，越小越靠前
  sortOrder   Int     @default(0) @map("sort_order")
  dishes      Dish[]

  @@map("dish_categories")
}

model IngredientCategoryL1 {
  id          Int                    @id @default(autoincrement())
  code        String                 @unique
  name        String
  description String?
  isActive    Boolean                @default(true) @map("is_active")
  // 展示顺序：设置页可调整，越小越靠前
  sortOrder   Int                    @default(0) @map("sort_order")
  children    IngredientCategoryL2[]

  @@map("ingredient_categories_l1")
}

model IngredientCategoryL2 {
  id          Int                  @id @default(autoincrement())
  code        String               @unique
  name        String
  parentCode  String               @map("parent_code")
  description String?
  isActive    Boolean              @default(true) @map("is_active")
  // 展示顺序：设置页可调整（同父级内排序），越小越靠前
  sortOrder   Int                  @default(0) @map("sort_order")
  parent      IngredientCategoryL1 @relation(fields: [parentCode], references: [code], onDelete: Cascade)

  @@index([parentCode, sortOrder])
  @@map("ingredient_categories_l2")
}

model Unit {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  category     String
  // 重量类单位必填：1 单位合多少克（斤=500、公斤=1000、克=1），驱动换算逻辑
  gramsPerUnit Decimal? @db.Decimal(10, 2) @map("grams_per_unit")
  isActive     Boolean  @default(true) @map("is_active")

  @@map("units")
}

model Supplier {
  id       Int               @id @default(autoincrement())
  name     String
  contact  String?
  phone    String?
  remark   String?
  receipts PurchaseReceipt[]
  ingredients     Ingredient[]
  sauceIngredients SauceIngredient[]
  purchasePlans   PurchasePlan[]

  @@map("suppliers")
}

model Ingredient {
  id             Int                   @id @default(autoincrement())
  code           String                @unique
  name           String
  alias          String?
  l2Code         String                @map("l2_code")
  purchaseSpec   String?               @map("purchase_spec")
  purchaseUnit   String?               @map("purchase_unit")
  stockUnit      String?               @map("stock_unit")
  // 入库数量：每 1 个采购单位对应的入库单位数（如 200g/袋*10袋 填 10；散称 = 1）
  unitsPerPurchase Int                 @default(1) @map("units_per_purchase")
  latestRefPrice Decimal?              @map("latest_ref_price") @db.Decimal(10, 2)
  pricePerJin    Decimal?              @map("price_per_jin") @db.Decimal(10, 4)
  season         String                @default("四季") @map("season")
  storage        String                @default("常温") @map("storage")
  deletedAt      DateTime?             @map("deleted_at")
  inventory      Inventory?
  defaultSupplierId Int?                @map("default_supplier_id")
  defaultSupplier   Supplier?             @relation(fields: [defaultSupplierId], references: [id])
  ledger         InventoryLedger[]
  netIngredients NetIngredient[]
  receiptItems   PurchaseReceiptItem[]

  @@map("ingredients")
}

model NetIngredient {
  id                 Int               @id @default(autoincrement())
  code               String            @unique
  name               String
  sourceIngredientId Int?              @map("source_ingredient_id")
  // 历史遗留字段：早期小料的自由文本规格（如「切末」），新数据不再写入，保留兼容
  spec               String?
  // 出成率（%）：净料/小料必填（原料转化口径）
  yieldRate          Decimal?          @map("yield_rate") @db.Decimal(5, 2)
  // 封装规格（g），净料/小料必填
  packageSpec        Int?              @map("package_spec")
  // 封装加工费（元/斤），空 = 0；净料/小料使用
  processingFeePerJin Decimal?         @map("processing_fee_per_jin") @db.Decimal(10, 2)
  // 毛利率（%）：空 = 0；出库价 = 成本价 ÷ (1 - 毛利率/100)，真毛利率口径
  grossMarginRate    Decimal?          @map("gross_margin_rate") @db.Decimal(5, 2)
  // 净料单价：净料/小料统一为 元/斤（原料每斤单价 ÷ 出成率）
  unitPrice          Decimal           @map("unit_price") @db.Decimal(10, 2)
  // 计量单位：统一 g（历史小料曾用 10g，已废弃）
  unit               String            @default("g") @map("unit")
  l2Code             String            @map("l2_code")
  storage            String            @default("冷藏") @map("storage")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  dishNetDetails     DishNetDetail[]
  dishMinorDetails   DishMinorDetail[]
  sourceIngredient   Ingredient?       @relation(fields: [sourceIngredientId], references: [id])

  @@index([sourceIngredientId])
  @@index([deletedAt])
  @@index([l2Code])
  @@map("net_ingredients")
}

model SauceIngredient {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  // 自制 / 外购
  type      String
  // 外购字段（同调料录入逻辑）：品牌、采购规格、采购单位、零售参考价（元/采购单位）
  brand          String?
  purchaseSpec   String?   @map("purchase_spec")
  purchaseUnit   String?   @map("purchase_unit")
  latestRefPrice Decimal?  @map("latest_ref_price") @db.Decimal(10, 2)
  // 每斤单价（元/斤）：服务端按采购规格自动换算，换算不出可手填；外购酱料成本价口径
  pricePerJin    Decimal?  @map("price_per_jin") @db.Decimal(10, 4)
  // 毛利率（%）：空 = 0；真毛利率口径，出库价 = 成本价 ÷ (1 - 毛利率/100)
  grossMarginRate Decimal? @map("gross_margin_rate") @db.Decimal(5, 2)
  // 加工费（元/斤）：自制酱料加工环节每斤成本，计入成本价；空 = 0
  processingFeePerJin Decimal? @map("processing_fee_per_jin") @db.Decimal(10, 2)
  // 封装规格（g）：标准封装单位克数；标准规格价（元/份）= 出库价 × 封装规格 ÷ 500，计算字段不落库
  packageSpec    Int?     @map("package_spec")
  storage        String   @default("常温") @map("storage")
  // 备注（延伸用途，如「还可烹制虾仁、鱼类」）
  remark         String?
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")
  recipeDetails  SauceRecipeDetail[]
  defaultSupplierId Int?            @map("default_supplier_id")
  defaultSupplier   Supplier?       @relation(fields: [defaultSupplierId], references: [id])
  dishSauceDetails DishSauceDetail[]

  @@map("sauce_ingredients")
}

// 自制酱料配方明细：镜像菜品 BOM 行，是酱料的成本来源
model SauceRecipeDetail {
  id      Int      @id @default(autoincrement())
  sauceId Int      @map("sauce_id")
  // net（净料/小料，引用 net_ingredients）/ seasoning（调料，引用 ingredients 中 SEA 调味品子树）
  lineType String  @map("line_type")
  refId    Int     @map("ref_id")
  amountG  Decimal @map("amount_g") @db.Decimal(10, 2)
  // 行成本（元）：保存时按当时价格体系计算（净料/小料按出库价、调料按每斤单价）
  cost     Decimal? @db.Decimal(10, 2)
  sauce    SauceIngredient @relation(fields: [sauceId], references: [id], onDelete: Cascade)

  @@unique([sauceId, lineType, refId])
  @@index([refId])
  @@map("sauce_recipe_details")
}


model DishMinorDetail {
  id            Int           @id @default(autoincrement())
  dishId        Int           @map("dish_id")
  netIngId      Int           @map("net_ing_id")
  amountG       Decimal       @map("amount_g") @db.Decimal(10, 2)
  brand         String?
  cost          Decimal?      @db.Decimal(10, 2)
  dish          Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  netIngredient NetIngredient @relation(fields: [netIngId], references: [id])

  @@map("dish_minor_details")
}

model Dish {
  id               Int                   @id @default(autoincrement())
  code             String                @unique
  name             String
  intro            String?
  categoryId       Int                   @map("category_id")
  cuisine          String?
  technique        String?
  taste            String?
  portion          String                @default("单人份")
  season           String                @default("四季")
  meatType         String?               @map("meat_type")
  cost             Decimal?              @db.Decimal(10, 2)
  price            Decimal?              @db.Decimal(10, 2) // 售价（元/份）
  status           String                @default("draft") @map("status") // draft / pending / published
  operator         String?
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  netDetails       DishNetDetail[]
  minorDetails     DishMinorDetail[]
  processes        DishProcess[]
  sauceDetails     DishSauceDetail[]
  seasoningDetails DishSeasoningDetail[]
  category         DishCategory          @relation(fields: [categoryId], references: [id])
  scheduleItems    ScheduleItem[]

  @@map("dishes")
}

model DishNetDetail {
  id            Int           @id @default(autoincrement())
  dishId        Int           @map("dish_id")
  role          String // main(主料) / support(辅料)
  netIngId      Int           @map("net_ing_id")
  amountG       Decimal       @map("amount_g") @db.Decimal(10, 2)
  spec          String?
  cost          Decimal?      @db.Decimal(10, 2)
  dish          Dish          @relation(fields: [dishId], references: [id], onDelete: Cascade)
  netIngredient NetIngredient @relation(fields: [netIngId], references: [id])

  @@map("dish_net_details")
}

model DishSeasoningDetail {
  id       Int      @id @default(autoincrement())
  dishId   Int      @map("dish_id")
  type     String // minor(小料) / seasoning(调料)
  sourceId Int      @map("source_id")
  amountG  Decimal  @map("amount_g") @db.Decimal(10, 2)
  brand    String?
  cost     Decimal? @db.Decimal(10, 2)
  dish     Dish     @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@map("dish_seasoning_details")
}

model DishSauceDetail {
  id      Int             @id @default(autoincrement())
  dishId  Int             @map("dish_id")
  sauceId Int             @map("sauce_id")
  amountG Decimal         @map("amount_g") @db.Decimal(10, 2)
  brand   String?
  cost    Decimal?        @db.Decimal(10, 2)
  dish    Dish            @relation(fields: [dishId], references: [id], onDelete: Cascade)
  sauce   SauceIngredient @relation(fields: [sauceId], references: [id])

  @@map("dish_sauce_details")
}

model DishProcess {
  id          Int     @id @default(autoincrement())
  dishId      Int     @map("dish_id")
  stage       String
  stepNo      Int     @map("step_no")
  object      String
  action      String
  description String?
  tool        String?
  standard    String?
  dish        Dish    @relation(fields: [dishId], references: [id], onDelete: Cascade)

  @@map("dish_processes")
}

model Store {
  id        Int        @id @default(autoincrement())
  code      String     @unique
  name      String     @unique
  manager   String?
  phone     String?
  address   String?
  // 系统内置门店（不可删除、不可停用）
  isSystem  Boolean    @default(false) @map("is_system")
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  deletedAt DateTime?  @map("deleted_at")
  schedules Schedule[]
  outboundOrders OutboundOrder[]

  @@index([deletedAt])
  @@map("stores")
}

model Schedule {
  id            Int            @id @default(autoincrement())
  code          String?        @unique
  title         String
  scheduleDate  DateTime       @map("schedule_date") @db.Date
  status        String         @default("待生效")
  storeId       Int            @map("store_id")
  operator      String?
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  cuttingOrders CuttingOrder[]
  purchasePlans PurchasePlan[]
  items         ScheduleItem[]
  productionPlanRefs ProductionPlanSchedule[]
  store         Store                 @relation(fields: [storeId], references: [id])

  @@map("schedules")
}

model ScheduleItem {
  id         Int      @id @default(autoincrement())
  scheduleId Int      @map("schedule_id")
  dishId     Int      @map("dish_id")
  quantity   Int
  actualSoldQty Decimal?  @db.Decimal(10, 2) @map("actual_sold_qty") // 实际售出份数（空 = 未回录）
  soldRecordedAt DateTime? @map("sold_recorded_at") // 本行最后回录时间
  soldRecordedBy String?   @map("sold_recorded_by") // 本行最后回录人（显示名）
  dish       Dish     @relation(fields: [dishId], references: [id])
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("schedule_items")
}

model PurchasePlan {
  id                Int      @id @default(autoincrement())
  scheduleId        Int      @map("schedule_id")
  sourceType        String   @map("source_type") // ingredient / seasoning / sauce（小料已按出成率并入 ingredient）
  sourceId          Int      @map("source_id")
  sourceCode        String?  @map("source_code") // 食材/酱料档案编码（基础数据，非拼接）
  itemName          String   @map("item_name")
  l2Code            String?  @map("l2_code")
  grossNeed         Decimal  @map("gross_need") @db.Decimal(10, 2) // 毛料需求（克）：净需求 × 100 ÷ 出成率
  stockDeducted     Decimal  @map("stock_deducted") @db.Decimal(10, 2) // 实际抵扣库存（斤），封顶毛料需求斤数
  suggestedPurchase Decimal  @map("suggested_purchase") @db.Decimal(10, 2) // 建议采购量（采购单位个数；规格无法换算时为斤）
  estimatedAmount   Decimal? @map("estimated_amount") @db.Decimal(10, 2) // 预估金额（元）= 需采购斤数 × 每斤单价
  unit              String
  purchaseSpec      String?  @map("purchase_spec")
  priceUnit         String?  @map("price_unit")
  actualPurchase    Decimal? @map("actual_purchase") @db.Decimal(10, 2)
  actualAmount      Decimal? @map("actual_amount") @db.Decimal(10, 2)
  supplierId        Int?     @map("supplier_id")
  supplierName      String?  @map("supplier_name")
  supplier          Supplier? @relation(fields: [supplierId], references: [id])
  status            String   @default("pending")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  schedule          Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("purchase_plans")
}

model CuttingOrder {
  id          Int      @id @default(autoincrement())
  scheduleId  Int      @map("schedule_id")
  sourceType  String   @map("source_type") // net / minor
  sourceId    Int      @map("source_id")
  sourceCode  String?  @map("source_code") // 净料/小料档案编码（基础数据，非拼接）
  packageSpec Int?     @map("package_spec") // 封装规格（g，净料档案）：切配份数 = 切配量 ÷ 封装规格
  itemName    String   @map("item_name")
  l1Code      String?  @map("l1_code")
  l2Code      String?  @map("l2_code")
  spec        String?
  requiredQty Decimal  @map("required_qty") @db.Decimal(10, 2)
  unit        String
  actualQty   Decimal? @map("actual_qty") @db.Decimal(10, 2)
  status      String   @default("pending")
  schedule    Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@map("cutting_orders")
}

model PurchaseReceipt {
  id             Int                   @id @default(autoincrement())
  receiptDate    DateTime              @map("receipt_date") @db.Date
  supplierId     Int?                  @map("supplier_id")
  supplierName   String?               @map("supplier_name")
  summary        String? // 采购摘要
  totalAmount    Decimal               @map("total_amount") @db.Decimal(10, 2)
  operator       String?
  imageUrl       String?               @map("image_url")
  purchasingUnit String                @default("切配中心") @map("purchasing_unit")
  imageHash      String?               @map("image_hash")
  status          String                 @default("待结算") // 待结算 / 已结算 / 已作废
  createdAt       DateTime               @default(now()) @map("created_at")
  reimbursementId Int?                   @map("reimbursement_id")
  items           PurchaseReceiptItem[]
  supplier        Supplier?              @relation(fields: [supplierId], references: [id])
  reimbursement   PurchaseReimbursement? @relation(fields: [reimbursementId], references: [id])

  @@map("purchase_receipts")
}

model PurchaseReceiptItem {
  id           Int             @id @default(autoincrement())
  receiptId    Int             @map("receipt_id")
  ingredientId Int?            @map("ingredient_id")
  itemName     String          @map("item_name")
  brand        String?
  l2Code       String?         @map("l2_code")
  l2Name       String?         @map("l2_name")
  isManual     Boolean         @default(false) @map("is_manual")
  spec         String?
  qty          Decimal         @db.Decimal(10, 2)
  priceUnit    String          @map("price_unit")
  purchaseUnit String?         @map("purchase_unit")
  unitPrice    Decimal         @map("unit_price") @db.Decimal(10, 2)
  amount       Decimal         @db.Decimal(10, 2)
  stockUnit    String          @map("stock_unit")
  stockInQty   Decimal         @map("stock_in_qty") @db.Decimal(10, 2)
  storage      String
  ingredient   Ingredient?     @relation(fields: [ingredientId], references: [id])
  receipt      PurchaseReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@map("purchase_receipt_items")
}

model Inventory {
  id           Int         @id @default(autoincrement())
  ingredientId Int?        @unique @map("ingredient_id")
  currentQty   Decimal     @map("current_qty") @db.Decimal(10, 2)
  unit         String
  updatedAt    DateTime    @updatedAt @map("updated_at")
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])

  @@map("inventory")
}

model InventoryLedger {
  id               Int         @id @default(autoincrement())
  ingredientId     Int?        @map("ingredient_id")
  changeTime       DateTime    @default(now()) @map("change_time")
  changeType       String      @map("change_type") // 入库 / 出库
  changeQty        Decimal     @map("change_qty") @db.Decimal(10, 2)
  unit             String
  balance          Decimal     @db.Decimal(10, 2)
  source           String
  settlementStatus String      @default("待结算") @map("settlement_status")
  operator         String?
  createdAt        DateTime    @default(now()) @map("created_at")
  ingredient       Ingredient? @relation(fields: [ingredientId], references: [id])

  @@map("inventory_ledger")
}

model PurchaseReimbursement {
  id          Int               @id @default(autoincrement())
  title       String // 报销主题
  summary     String? // 摘要
  totalAmount Decimal           @map("total_amount") @db.Decimal(10, 2)
  status      String            @default("pending") // pending / settled
  operator    String?
  createdAt   DateTime          @default(now()) @map("created_at")
  receipts    PurchaseReceipt[]

  @@map("purchase_reimbursements")
}

model User {
  id             Int            @id @default(autoincrement())
  username       String         @unique
  password       String
  name           String?
  role           String?        @map("role")
  isActive       Boolean        @default(true) @map("is_active")
  sessionVersion Int            @default(1) @map("session_version")
  deletedAt      DateTime?      @map("deleted_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  logs           OperationLog[]

  @@index([deletedAt])

  @@map("users")
}

model OperationLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  action      String // CREATE, UPDATE, DELETE, LOGIN, LOGOUT
  entity      String // 操作的实体名称，如 Ingredient, DishCategory
  entityId    Int?     @map("entity_id")
  description String?
  ip          String?
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id])

  @@map("operation_logs")
}

// 切配中心生产计划单：跨店汇总「进行中」排程单的切配工单与采购计划（生成时快照固化）
model ProductionPlan {
  id          Int      @id @default(autoincrement())
  code        String?  @unique // 编号：PPL-生产日期-当日序号
  title       String
  planDate    DateTime @map("plan_date") @db.Date
  status      String   @default("待生效") // 与排程单一致：待生效 / 进行中 / 已完成
  operator    String?
  cuttingJson Json?    @map("cutting_json") // 汇总切配工单明细快照
  purchaseJson Json?   @map("purchase_json") // 汇总采购计划明细快照
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")
  schedules   ProductionPlanSchedule[]

  @@map("production_plans")
}

// 生产计划单 ↔ 来源排程单（溯源）
model ProductionPlanSchedule {
  id         Int            @id @default(autoincrement())
  planId     Int            @map("plan_id")
  scheduleId Int            @map("schedule_id")
  plan       ProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  schedule   Schedule       @relation(fields: [scheduleId], references: [id])

  @@unique([planId, scheduleId])
  @@map("production_plan_schedules")
}

// ===== 净菜库存（v002）：切配中心库存只管理加工完成的净菜（净料+小料），按份出入库 =====

// 净菜库存表：份为记账主单位，g 按当时封装规格换算同步累加（金额计算/展示用）
model PreppedStock {
  id              Int      @id @default(autoincrement())
  sourceType      String   @map("source_type") // net / minor
  sourceId        Int      @map("source_id")
  currentPortions Decimal  @map("current_portions") @db.Decimal(12, 2)
  currentQty      Decimal  @map("current_qty") @db.Decimal(14, 2)
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@unique([sourceType, sourceId])
  @@map("prepped_stock")
}

// 净菜库存台账：双单位（份 + g）流水
model PreppedStockLedger {
  id              Int      @id @default(autoincrement())
  sourceType      String   @map("source_type")
  sourceId        Int      @map("source_id")
  changeType      String   @map("change_type") // stock_in / stock_out / stock_rollback
  changePortions  Decimal  @map("change_portions") @db.Decimal(12, 2)
  changeQty       Decimal  @map("change_qty") @db.Decimal(14, 2)
  balancePortions Decimal  @map("balance_portions") @db.Decimal(12, 2)
  balanceQty      Decimal  @map("balance_qty") @db.Decimal(14, 2)
  bizType         String   @map("biz_type") // production_complete / outbound / outbound_void
  bizId           Int?     @map("biz_id")
  bizRefCode      String?  @map("biz_ref_code")
  scheduleId      Int?     @map("schedule_id")
  storeId         Int?     @map("store_id")
  itemCode        String?  @map("item_code")
  itemName        String   @map("item_name")
  l1Name          String?  @map("l1_name")
  l2Name          String?  @map("l2_name")
  operator        String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([sourceType, sourceId])
  @@index([createdAt])
  @@map("prepped_stock_ledger")
}

// 净菜出库单：创建即扣库存（confirmed），作废回滚（voided，作废≠删除）
model OutboundOrder {
  id             Int      @id @default(autoincrement())
  code           String   @unique // OUT-YYYYMMDD-NNN（当日序号）
  scheduleId     Int      @map("schedule_id")
  storeId        Int      @map("store_id")
  scheduleCode   String?  @map("schedule_code")
  scheduleTitle  String   @map("schedule_title")
  scheduleDate   DateTime @map("schedule_date") @db.Date
  totalPortions  Decimal  @map("total_portions") @db.Decimal(12, 2)
  totalAmount    Decimal  @map("total_amount") @db.Decimal(12, 2)
  asPlanned      Boolean  @default(true) @map("as_planned") // 是否按计划出库：逐行 shipped == required
  status         String   @default("confirmed") // confirmed / voided
  operator       String? // 库管负责人（制单人）
  remark         String?
  createdAt      DateTime @default(now()) @map("created_at")
  voidedAt       DateTime? @map("voided_at")
  voidReason     String?   @map("void_reason")
  store          Store    @relation(fields: [storeId], references: [id])
  items          OutboundOrderItem[]

  @@index([storeId])
  @@index([status])
  @@index([createdAt])
  @@map("outbound_orders")
}

model OutboundOrderItem {
  id                Int      @id @default(autoincrement())
  outboundOrderId   Int      @map("outbound_order_id")
  sourceType        String   @map("source_type")
  sourceId          Int      @map("source_id")
  itemCode          String?  @map("item_code")
  itemName          String   @map("item_name")
  l1Name            String?  @map("l1_name")
  l2Name            String?  @map("l2_name")
  packageSpec       Int?     @map("package_spec")
  requiredPortions  Decimal  @map("required_portions") @db.Decimal(12, 2)
  requiredQty       Decimal  @map("required_qty") @db.Decimal(14, 2)
  availablePortions Decimal  @map("available_portions") @db.Decimal(12, 2)
  shippedPortions   Decimal  @map("shipped_portions") @db.Decimal(12, 2)
  shippedQty        Decimal  @map("shipped_qty") @db.Decimal(14, 2)
  pricePerJin       Decimal? @map("price_per_jin") @db.Decimal(10, 2) // 出库价快照（元/斤）
  amount            Decimal  @map("amount") @db.Decimal(12, 2) // 行金额 = 出库价 × shippedQty ÷ 500
  prepStatus        String   @default("normal") @map("prep_status") // normal / insufficient / unfinished
  sortIndex         Int      @map("sort_index")
  outboundOrder     OutboundOrder @relation(fields: [outboundOrderId], references: [id], onDelete: Cascade)

  @@map("outbound_order_items")
}
